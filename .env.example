# Copy to .env and fill in real values. Do not put real credentials in this file.

# Neon POOLED connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional: Neon DIRECT (non-pooled) connection string, used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
