// Prisma schema for DayTodayNews (MariaDB/MySQL).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EDITOR
}

enum ArticleStatus {
  DRAFT
  // Written, waiting for an editor's fact-check before publishing (never public).
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

// Editorial articles, expert guest contributions and paid (sponsored) articles.
// Sponsored ones are labelled on the site and their outbound links carry
// rel="sponsored", as Google's link-spam policy requires for paid placements.
enum ArticleType {
  EDITORIAL
  GUEST
  SPONSORED
}

enum ListingKind {
  BUSINESS
  SOFTWARE
  STARTUP
}

// Basic = free; Verified = details checked by the team; Featured = paid placement (labelled).
enum ListingTier {
  BASIC
  VERIFIED
  FEATURED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadType {
  ADVERTISING
  LISTING_ENQUIRY
}

enum LeadStatus {
  NEW
  CONTACTED
  FORWARDED
  WON
  CLOSED
}

enum PlanStatus {
  IDEA
  ASSIGNED
  WRITING
  REVIEW
  SCHEDULED
  PUBLISHED
}

enum PlanKind {
  NEW
  REFRESH
}

enum SubmissionStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum PitchStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  role         Role      @default(EDITOR)
  avatar       String?
  bio          String?   @db.Text
  isActive     Boolean   @default(true)
  articles     Article[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Topic {
  id          String    @id @default(cuid())
  slug        String    @unique
  label       String
  description String    @db.Text
  href        String
  icon        String
  tone        String
  articles    Article[]
  translations TopicTranslation[]
  seo          SeoMeta[]
  menuTopics   MenuTopic[]
  // Category page: longer introduction (markdown), shown on its first page.
  intro       String?   @db.Text
  // The category's pillar guide ("Start here"), an article slug.
  pillarSlug  String?   @db.VarChar(191)
  // Call to action at the end of its articles and on its page, e.g.
  // "Find AI automation providers" → /business-directory?category=AI%20Automation
  ctaTitle    String?   @db.VarChar(150)
  ctaText     String?   @db.Text
  ctaLabel    String?   @db.VarChar(80)
  ctaHref     String?   @db.VarChar(2048)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("topics")
}

// Category name/description in another language (the Topic row holds English).
model TopicTranslation {
  id          String   @id @default(cuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  locale      String   @db.VarChar(10)
  label       String
  description String?  @db.Text
  intro       String?  @db.Text
  ctaTitle    String?  @db.VarChar(150)
  ctaText     String?  @db.Text
  ctaLabel    String?  @db.VarChar(80)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([topicId, locale])
  @@map("topic_translations")
}

model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String        @db.VarChar(255)
  description   String?       @db.Text
  content       String?       @db.LongText
  readTime      Int           @default(5)
  authorName    String
  authorId      String?
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  topicSlug     String
  topic         Topic         @relation(fields: [topicSlug], references: [slug], onDelete: Restrict)

  // Cover Art Specification
  coverPattern  String?
  coverTones    String?       // JSON stringified e.g. '["accent-secondary", "pink"]'
  coverIcon     String?
  imageUrl      String?
  imageAlt      String?

  // Editorial Flags
  featured      Boolean       @default(false)
  editorsPick   Boolean       @default(false)
  trending      Boolean       @default(false)
  trendingRank  Int?

  status        ArticleStatus @default(PUBLISHED)
  viewsCount    Int           @default(0)
  // A published article with a future date is scheduled: it stays hidden until then.
  publishedAt   DateTime      @default(now())
  // Last meaningful edit (text changed). Shown as "Updated", and used for
  // dateModified and the sitemap. `updatedAt` also moves on view counts and
  // flag toggles, so it is not used for that.
  contentUpdatedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Editorial framework (90-day plan): one focus keyword, key takeaways and FAQs.
  focusKeyword  String?       @db.VarChar(150)
  takeaways     String?       @db.Text // One point per line.
  faq           String?       @db.Text // JSON: [{ "q": "...", "a": "..." }]

  articleType   ArticleType   @default(EDITORIAL)
  sponsorName   String?       @db.VarChar(150)
  sponsorUrl    String?       @db.VarChar(2048)

  // Topic clusters: a pillar guide, and the supporting articles that point to it.
  isPillar      Boolean       @default(false)
  pillarSlug    String?       @db.VarChar(191)

  // Directory listings shown under the article (JSON array of listing slugs).
  relatedListings String?     @db.Text
  // Downloadable checklists/resources (JSON: [{ "label": "...", "url": "..." }]).
  resources     String?       @db.Text

  translations  ArticleTranslation[]
  seo           SeoMeta[]

  @@index([topicSlug])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([pillarSlug])
  @@index([featured, editorsPick, trending])
  @@map("articles")
}

// Article text in another language (the Article row holds English).
model ArticleTranslation {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale      String   @db.VarChar(10)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  content     String?  @db.LongText
  focusKeyword String? @db.VarChar(150)
  takeaways   String?  @db.Text
  faq         String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([articleId, locale])
  @@map("article_translations")
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  status       SubscriberStatus @default(ACTIVE)
  subscribedAt DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("newsletter_subscribers")
}

model ContactSubmission {
  id        String           @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String           @db.Text
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("contact_submissions")
}

model ContributorPitch {
  id        String      @id @default(cuid())
  name      String
  email     String
  topic     String
  portfolio String?
  idea      String      @db.VarChar(255)
  message   String      @db.Text
  status    PitchStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("contributor_pitches")
}

model SiteSetting {
  key       String   @id
  value     String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// SEO overrides for one page, article or category in one language. Exactly one
// of pageKey / articleId / topicId is set. Empty fields mean "use the automatic
// value" (the page's own text, then the site-wide defaults).
model SeoMeta {
  id              String   @id @default(cuid())
  locale          String   @db.VarChar(10)
  pageKey         String?  @db.VarChar(50)
  articleId       String?
  article         Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topicId         String?
  topic           Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  keywords        String?  @db.Text
  ogTitle         String?  @db.VarChar(255)
  ogDescription   String?  @db.Text
  ogImage         String?  @db.VarChar(2048)
  canonicalUrl    String?  @db.VarChar(2048)
  noIndex         Boolean  @default(false)
  noFollow        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([pageKey, locale])
  @@unique([articleId, locale])
  @@unique([topicId, locale])
  @@map("seo_meta")
}

// Fixed-window counters for login and form rate limits. `key` holds the action
// and a SHA-256 hash of the IP or email, never the raw value.
model RateLimit {
  key     String   @id @db.VarChar(191)
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}

// A sub-topic link in a category's mega menu, managed under Admin → Categories.
// Either a search keyword (links to /search within the category) or a direct
// link (a site path or https URL); a link wins when both are set.
model MenuTopic {
  id         String   @id @default(cuid())
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  labelEn    String   @db.VarChar(100)
  labelHi    String?  @db.VarChar(100)
  query      String?  @db.VarChar(200)
  href       String?  @db.VarChar(2048)
  // Keyword topics are hidden while no article matches, unless this is on.
  alwaysShow Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([topicId, sortOrder])
  @@map("menu_topics")
}

// A permanent (301) redirect from an old site path, e.g. after a slug change or
// when two overlapping articles are merged. Paths are unprefixed ("/articles/x")
// and apply in every language; the target is a site path or an https URL.
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique @db.VarChar(191)
  toPath    String   @db.VarChar(2048)
  note      String?  @db.VarChar(255)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("redirects")
}

// An entry in the business, software or startup directory. Submitted from the
// site as PENDING and published by staff; English only (global audience).
model Listing {
  id              String        @id @default(cuid())
  kind            ListingKind
  slug            String        @unique @db.VarChar(191)
  name            String        @db.VarChar(150)
  tagline         String?       @db.VarChar(255)
  description     String?       @db.Text
  logoUrl         String?       @db.VarChar(2048)
  website         String?       @db.VarChar(2048)
  // Enquiries from readers are forwarded to this address.
  email           String?       @db.VarChar(254)
  phone           String?       @db.VarChar(40)
  country         String?       @db.VarChar(80)
  city            String?       @db.VarChar(80)
  // Industry / business category, or the software's product category.
  category        String?       @db.VarChar(120)
  // Products & services (business) or key features (software): one per line.
  services        String?       @db.Text
  specialties     String?       @db.Text
  certifications  String?       @db.Text
  pricingModel    String?       @db.VarChar(150)
  platforms       String?       @db.VarChar(255)
  // Screenshot image URLs, one per line.
  screenshots     String?       @db.Text
  useCases        String?       @db.Text
  targetCustomers String?       @db.Text
  // Alternatives, one name per line.
  alternatives    String?       @db.Text
  foundedYear     Int?
  teamSize        String?       @db.VarChar(40)
  stage           String?       @db.VarChar(60)
  funding         String?       @db.VarChar(150)
  tier            ListingTier   @default(BASIC)
  status          ListingStatus @default(PENDING)
  submitterName   String?       @db.VarChar(100)
  submitterEmail  String?       @db.VarChar(254)
  adminNotes      String?       @db.Text
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  leads           Lead[]

  @@index([kind, status, tier])
  @@map("listings")
}

// A commercial enquiry: an advertiser, or a reader contacting a listed company.
// `sourcePath` records the page the visitor came from (lead attribution).
model Lead {
  id          String     @id @default(cuid())
  type        LeadType
  name        String     @db.VarChar(100)
  email       String     @db.VarChar(254)
  company     String?    @db.VarChar(150)
  phone       String?    @db.VarChar(40)
  website     String?    @db.VarChar(2048)
  interest    String?    @db.VarChar(150)
  budget      String?    @db.VarChar(100)
  message     String     @db.Text
  listingId   String?
  listing     Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sourcePath  String?    @db.VarChar(512)
  status      LeadStatus @default(NEW)
  forwardedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type, status])
  @@index([listingId])
  @@map("leads")
}

// A newsletter edition composed and sent from Admin → Newsletter.
model NewsletterIssue {
  id           String    @id @default(cuid())
  subject      String    @db.VarChar(200)
  intro        String?   @db.Text
  // JSON array of article slugs, in order.
  articleSlugs String?   @db.Text
  sponsorName  String?   @db.VarChar(150)
  sponsorText  String?   @db.Text
  sponsorUrl   String?   @db.VarChar(2048)
  sentAt       DateTime?
  recipients   Int       @default(0)
  failed       Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("newsletter_issues")
}

// One row of the 90-day editorial plan (Admin → Editorial Plan): an article to
// write or an existing one to refresh, with its keywords, people and status.
model PlanItem {
  id                String     @id @default(cuid())
  number            Int?
  kind              PlanKind   @default(NEW)
  title             String     @db.VarChar(255)
  focusKeyword      String?    @db.VarChar(150)
  secondaryKeywords String?    @db.Text
  category          String?    @db.VarChar(120)
  wordTarget        Int?
  month             Int?
  dueDate           DateTime?
  // Staff user ids (no foreign key: a removed user just shows as unassigned).
  writerId          String?    @db.VarChar(191)
  editorId          String?    @db.VarChar(191)
  status            PlanStatus @default(IDEA)
  articleSlug       String?    @db.VarChar(191)
  metaTitle         String?    @db.VarChar(255)
  metaDescription   String?    @db.Text
  // JSON array of the finished checklist item keys.
  checklist         String?    @db.Text
  notes             String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([month, number])
  @@map("plan_items")
}
