// Prisma schema for DayTodayNews (MariaDB/MySQL).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EDITOR
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum PitchStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  role         Role      @default(EDITOR)
  avatar       String?
  bio          String?   @db.Text
  isActive     Boolean   @default(true)
  articles     Article[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Topic {
  id          String    @id @default(cuid())
  slug        String    @unique
  label       String
  description String    @db.Text
  href        String
  icon        String
  tone        String
  articles    Article[]
  translations TopicTranslation[]
  seo          SeoMeta[]
  menuTopics   MenuTopic[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("topics")
}

// Category name/description in another language (the Topic row holds English).
model TopicTranslation {
  id          String   @id @default(cuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  locale      String   @db.VarChar(10)
  label       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([topicId, locale])
  @@map("topic_translations")
}

model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String        @db.VarChar(255)
  description   String?       @db.Text
  content       String?       @db.LongText
  readTime      Int           @default(5)
  authorName    String
  authorId      String?
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  topicSlug     String
  topic         Topic         @relation(fields: [topicSlug], references: [slug], onDelete: Restrict)

  // Cover Art Specification
  coverPattern  String?
  coverTones    String?       // JSON stringified e.g. '["accent-secondary", "pink"]'
  coverIcon     String?
  imageUrl      String?
  imageAlt      String?

  // Editorial Flags
  featured      Boolean       @default(false)
  editorsPick   Boolean       @default(false)
  trending      Boolean       @default(false)
  trendingRank  Int?

  status        ArticleStatus @default(PUBLISHED)
  viewsCount    Int           @default(0)
  publishedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  translations  ArticleTranslation[]
  seo           SeoMeta[]

  @@index([topicSlug])
  @@index([publishedAt])
  @@index([featured, editorsPick, trending])
  @@map("articles")
}

// Article text in another language (the Article row holds English).
model ArticleTranslation {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale      String   @db.VarChar(10)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  content     String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([articleId, locale])
  @@map("article_translations")
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  status       SubscriberStatus @default(ACTIVE)
  subscribedAt DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("newsletter_subscribers")
}

model ContactSubmission {
  id        String           @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String           @db.Text
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("contact_submissions")
}

model ContributorPitch {
  id        String      @id @default(cuid())
  name      String
  email     String
  topic     String
  portfolio String?
  idea      String      @db.VarChar(255)
  message   String      @db.Text
  status    PitchStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("contributor_pitches")
}

model SiteSetting {
  key       String   @id
  value     String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// SEO overrides for one page, article or category in one language. Exactly one
// of pageKey / articleId / topicId is set. Empty fields mean "use the automatic
// value" (the page's own text, then the site-wide defaults).
model SeoMeta {
  id              String   @id @default(cuid())
  locale          String   @db.VarChar(10)
  pageKey         String?  @db.VarChar(50)
  articleId       String?
  article         Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topicId         String?
  topic           Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  keywords        String?  @db.Text
  ogTitle         String?  @db.VarChar(255)
  ogDescription   String?  @db.Text
  ogImage         String?  @db.VarChar(2048)
  canonicalUrl    String?  @db.VarChar(2048)
  noIndex         Boolean  @default(false)
  noFollow        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([pageKey, locale])
  @@unique([articleId, locale])
  @@unique([topicId, locale])
  @@map("seo_meta")
}

// Fixed-window counters for login and form rate limits. `key` holds the action
// and a SHA-256 hash of the IP or email, never the raw value.
model RateLimit {
  key     String   @id @db.VarChar(191)
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}

// A sub-topic link in a category's mega menu, managed under Admin → Categories.
// Either a search keyword (links to /search within the category) or a direct
// link (a site path or https URL); a link wins when both are set.
model MenuTopic {
  id         String   @id @default(cuid())
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  labelEn    String   @db.VarChar(100)
  labelHi    String?  @db.VarChar(100)
  query      String?  @db.VarChar(200)
  href       String?  @db.VarChar(2048)
  // Keyword topics are hidden while no article matches, unless this is on.
  alwaysShow Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([topicId, sortOrder])
  @@map("menu_topics")
}
